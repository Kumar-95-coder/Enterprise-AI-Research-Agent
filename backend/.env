# Copy this file to .env and adjust as needed. Every value below has a
# working default that requires no external service or API key.

# --- Database ---
# SQLite by default (zero config). For production:
# DATABASE_URL=postgresql+psycopg2://research:research@localhost:5432/research_agent
DATABASE_URL=sqlite:///./research_agent.db

# --- LLM provider ---
# heuristic (default, no key needed) | anthropic | openai | ollama (local, no key)
LLM_PROVIDER=heuristic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only used when LLM_PROVIDER=ollama -- install from https://ollama.com,
# `ollama pull llama3.2`, no API key needed:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Search / retrieval provider ---
# local_corpus (default, searches backend/seed/corpus.json, no key needed)
# | live_http (needs SEARCH_API_KEY)
# | searxng (self-hosted, no key -- `docker compose --profile search up`)
# | duckduckgo (no key, no service to run, but more fragile -- `pip install ddgs`)
SEARCH_PROVIDER=local_corpus
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
SEARXNG_URL=http://localhost:8888

# --- Embeddings / semantic search ---
# tfidf (default, fully local, no key needed) | sentence-transformers
EMBEDDING_MODEL=tfidf

# --- Background processing (see docs/scaling.md) ---
# asyncio (default, runs in-process via FastAPI BackgroundTasks) | celery
BACKGROUND_MODE=asyncio
REDIS_URL=redis://localhost:6379/0

# --- Misc ---
LOG_LEVEL=INFO
CORS_ORIGINS=*
